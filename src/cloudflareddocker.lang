# ===========================================================================
# Multilingual file for the TOS 7 Docker application "cloudflareddocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Cloudflared Web"
auth         = "WisdomSky"
version      = "@@VERSION@@"
descript     = "Cloudflared Web puts the Cloudflare Tunnel client behind a small web UI: paste a remotely-managed tunnel token, start or stop the tunnel with one click and see its status, without touching the CLI. The container runs as uid 1000, keeps its configuration in the application data folder and needs only outbound HTTPS to Cloudflare."
release_note = "Rectified per review comments (review of 2026.5.0-2): C2 licence and trademark notices in NOTICE.md; C3-C5 privacy policy added in PRIVACY.md and linked from the App Center help link; C6 data collection, C7 user rights/deletion channel and C8 third-party APIs (Cloudflare edge, Cloudflare API, Docker Hub update check) disclosed; C9/F5 description rewritten to match the delivered features (removed the client-download claim, documented bridge networking); C10 README and repository layout documented; S1 container pinned to uid 1000 with cap_drop ALL and no-new-privileges (evidence: docs/ROOT-PRIVILEGE.md); S12/T1-T3 checksums regenerated and verified, CVE follow-up recorded. No root privilege is used by the package."
important    = "Open http://<NAS-IP>:8121/, paste the tunnel token from the Cloudflare Zero Trust dashboard and press Start. Public hostnames are configured in that dashboard; a tunnel target must be reachable from the container, so use the NAS LAN IP instead of 127.0.0.1. Data lives in /Volume1/DockerAppData/cloudflareddocker/. The web UI has no built-in login unless BASIC_AUTH_PASS is set: keep it on the LAN or behind a reverse proxy."

[zh-cn]
name         = "Cloudflared Web"
auth         = "WisdomSky"
version      = "@@VERSION@@"
descript     = "Cloudflared Web 用一个简洁的网页界面管理 Cloudflare Tunnel：粘贴 Zero Trust 远程隧道令牌，一键启动或停止隧道并查看状态，无需使用命令行。容器以 uid 1000 运行，配置保存在应用数据目录，只需要访问 Cloudflare 的出站 HTTPS。"
release_note = "按上轮审核意见整改：补充隐私政策（C3-C5）与第三方 API 披露（C8），说明数据收集（C6）与用户数据权利渠道（C7），描述与实际功能对齐（C9/F5），补充许可证与商标声明（C2），完善 README 与仓库结构（C10），容器以 uid 1000 运行并收紧权限（S1），重新生成并核对校验和（S12/T1-T3）。"
important    = "打开 http://<NAS-IP>:8121/，粘贴 Cloudflare Zero Trust 控制台里的隧道令牌，再点启动。公网主机名在控制台配置；隧道目标必须能从容器访问，请填 NAS 的局域网 IP，不要填 127.0.0.1。数据保存在 /Volume1/DockerAppData/cloudflareddocker/。界面默认无登录，除非设置 BASIC_AUTH_PASS：请仅在局域网使用或置于反向代理之后。"

[zh-hk]
name         = "Cloudflared Web"
auth         = "WisdomSky"
version      = "@@VERSION@@"
descript     = "Cloudflared Web 用一個簡潔的網頁介面管理 Cloudflare Tunnel：貼上 Zero Trust 遠端隧道權杖，一鍵啟動或停止隧道並檢視狀態，無需使用命令列。容器以 uid 1000 執行，設定保存在應用資料目錄，只需存取 Cloudflare 的對外 HTTPS。"
release_note = "依上輪審核意見整改：補充隱私政策（C3-C5）與第三方 API 揭露（C8），說明資料收集（C6）與使用者資料權利管道（C7），描述與實際功能對齊（C9/F5），補充授權與商標聲明（C2），完善 README 與倉庫結構（C10），容器以 uid 1000 執行並收緊權限（S1），重新產生並核對校驗和（S12/T1-T3）。"
important    = "開啟 http://<NAS-IP>:8121/，貼上 Cloudflare Zero Trust 主控台裡的隧道權杖，再按啟動。公開主機名在主控台設定；隧道目標必須能從容器存取，請填 NAS 的區域網路 IP，不要填 127.0.0.1。資料保存在 /Volume1/DockerAppData/cloudflareddocker/。介面預設無登入，除非設定 BASIC_AUTH_PASS：請僅在區域網路使用或置於反向代理之後。"

